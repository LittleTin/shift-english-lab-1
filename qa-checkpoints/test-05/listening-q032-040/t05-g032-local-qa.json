        {
          "source": "t05-g032-range-cue",
          "voice": "en-US-AriaNeural",
          "text": "Questions thirty-two through thirty-four refer to the following conversation.",
          "sha": "a614397e521fbbfe34b9a8931b0168972bca6774b61c6f35efe0656e412e3e20",
          "onsetTail48k": [
            6995,
