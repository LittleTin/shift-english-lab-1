      "options": [
        {
          "id": "A",
          "text": "Wait and collect both items on Saturday.",
          "zh": "等到星期六一次領兩件。",
          "whyZh": "兩件雖可保留到星期六，但她今晚需要桌燈。"
        },
        {
          "id": "B",
          "text": "Have her collect the lamp with only her phone today; he comes Saturday.",
          "zh": "今天讓她只帶電話來取桌燈，他星期六再來。",
          "whyZh": "電話可以查詢，但取貨仍要出示姓名相符的證件。"
        },
        {
          "id": "C",
          "text": "Bring matching ID for the lamp today; collect the notebook Saturday after its notice.",
          "zh": "今天帶姓名相符的證件領桌燈；收到筆記本通知後，星期六再來領。",
          "whyZh": "哥哥可出示與訂單相符的證件，先滿足今晚的桌燈需求；筆記本另行通知後可保留到星期六。"
        },
        {
          "id": "D",
          "text": "Collect both today, using the same pickup message for the notebook.",
          "zh": "今天用同一則簡訊把兩件都領走。",
          "whyZh": "筆記本明天才到，今天不能領；它也會有自己的通知。"
        }
      ],
      "answer": "C",
      "explanationZh": "哥哥可出示與訂單相符的證件，先滿足今晚的桌燈需求；筆記本另行通知後可保留到星期六。",
