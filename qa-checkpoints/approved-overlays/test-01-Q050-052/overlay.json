    "turns": [
      {
        "voice": "female",
        "text": "Keep the public elevator free from ten. It’s our only step-free route upstairs."
      },
      {
        "voice": "male",
        "text": "The freight elevator is free at ten thirty. We need both movers for twenty minutes; one leaves at eleven. Office first?"
      },
      {
        "voice": "female",
        "text": "Let’s not give the case a guided tour. Every handover needs a seal check. The driver can wait."
      },
      {
        "voice": "male",
        "text": "At eleven the room shows as available, and the display can run. Facilities inspects at eleven thirty."
      },
      {
        "voice": "female",
        "text": "The screen shows bookings. Reception needs Facilities clearance before admitting visitors to see displays."
      }
