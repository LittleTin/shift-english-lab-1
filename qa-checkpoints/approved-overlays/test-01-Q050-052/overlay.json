          "zh": "帶某人參觀導覽",
          "note": "這裡把展示櫃比作來參觀的人，用玩笑婉拒多停一站。"
        },
        {
          "term": "handover",
          "zh": "交接",
          "note": "指人員或地點變更時移交管理責任。"
        }
      ]
    },
